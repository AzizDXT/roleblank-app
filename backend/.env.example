# =============================================================================
# RoleBlank OS — backend configuration template
#
# Copy to `.env` for DEVELOPMENT ONLY. `.env` is git-ignored and is never read in
# production: relying on a file that may or may not be present is how a production
# instance ends up running with a developer's key.
#
# In production every value below comes from the secret manager / orchestrator
# environment. `roleblank-api check-config` validates the whole set and exits
# non-zero on any problem, so it can be run as a deployment gate.
# =============================================================================

# development | test | production
# Production applies strict validation and REFUSES TO START on: wildcard CORS,
# non-https origins, placeholder secrets, a privileged database role, a disabled
# TLS database connection, a public OpenAPI document, text logs, or a development
# mail sink.
RB_ENV=development

RB_BIND_ADDRESS=0.0.0.0:8080
RB_PUBLIC_BASE_URL=http://localhost:8090

# -----------------------------------------------------------------------------
# Database
#
# The application connects as the UNPRIVILEGED runtime role, never as the schema
# owner. `roleblank_migrator` owns the schema and is used only by
# `roleblank-api migrate`. Production startup refuses a URL that connects as
# postgres / roleblank_migrator / root / admin.
#
# Provision both roles with: .\scripts\rb.ps1 db-provision
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://roleblank_app:dev_app_pw@roleblank-postgres:5432/roleblank

# Pool sizing. PostgreSQL degrades above roughly (cores x 2-4) active connections
# because of lock and buffer contention, so the default is modest and measured.
# Measure before raising — see docs/backend/PERFORMANCE_REPORT.md.
RB_DB_MAX_CONNECTIONS=10
RB_DB_MIN_CONNECTIONS=1
RB_DB_ACQUIRE_TIMEOUT_SECONDS=5
RB_DB_IDLE_TIMEOUT_SECONDS=300
RB_DB_MAX_LIFETIME_SECONDS=1800
# Applied to every connection in the startup packet. A runaway query is a denial
# of service against the whole pool.
RB_DB_STATEMENT_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Secrets — 32 bytes each, base64
#
#   openssl rand -base64 32
#
# These two MUST be different keys. Reusing one key across an AEAD and an HMAC is
# a cross-protocol mistake, and it would mean an attacker who obtained one
# capability obtained both. Startup refuses identical values.
#
# THE VALUES BELOW ARE PUBLIC PLACEHOLDERS FOR LOCAL DEVELOPMENT.
# They are all-zero-derived on purpose so that accidentally shipping one is
# obvious. Production startup rejects all-zero keys outright.
# -----------------------------------------------------------------------------

# Encrypts TOTP secrets at rest (XChaCha20-Poly1305).
RB_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS1lbmNyeXB0aW9uLWtleS0xMjM=
RB_ENCRYPTION_KEY_VERSION=1

# Key rotation: set the previous key and its version so existing ciphertexts stay
# readable while a background pass re-encrypts. Removing a version before that
# pass completes makes the affected rows permanently unreadable.
# RB_ENCRYPTION_KEY_PREVIOUS=
# RB_ENCRYPTION_KEY_PREVIOUS_VERSION=

# HMAC key for the audit hash chain. Held separately from the database credentials
# on purpose: an adversary with only the database cannot forge a consistent chain.
# Export a copy to somewhere the database administrator cannot reach, or the
# tamper-evidence claim is void (see docs/adr/ADR-006-audit-integrity.md).
RB_AUDIT_CHAIN_KEY=ZGV2ZWxvcG1lbnQtb25seS1hdWRpdC1jaGFpbi1rZXktMDE=

# First-run bootstrap secret. Minimum 32 characters.
#
# REMOVE THIS FROM PRODUCTION SECRET CONFIGURATION ONCE THE SYSTEM IS
# INITIALISED. The endpoint refuses to run a second time regardless, but a secret
# with no remaining purpose is pure risk.
RB_BOOTSTRAP_SECRET=development-only-bootstrap-secret-change-me-0123456789

# -----------------------------------------------------------------------------
# Password hashing (Argon2id)
#
# Defaults meet current OWASP guidance and were benchmarked on the target
# hardware. Startup refuses anything weaker than 19456 KiB / 2 iterations.
#
# Concurrency is bounded because Argon2id is intentionally memory-hard: without a
# cap, a login flood turns our own KDF into an amplification weapon against us.
# -----------------------------------------------------------------------------
RB_ARGON2_MEMORY_KIB=19456
RB_ARGON2_ITERATIONS=2
RB_ARGON2_PARALLELISM=1
RB_AUTH_HASHING_MAX_CONCURRENCY=8

# -----------------------------------------------------------------------------
# Sessions
#
# `absolute` is a hard ceiling that no amount of refreshing extends, so every
# compromise has a bounded end.
# -----------------------------------------------------------------------------
RB_SESSION_ACCESS_TTL_SECONDS=900          # 15 minutes
RB_SESSION_IDLE_TTL_SECONDS=604800         # 7 days
RB_SESSION_ABSOLUTE_TTL_SECONDS=2592000    # 30 days
RB_SESSION_REFRESH_TTL_SECONDS=604800      # 7 days
RB_SESSION_MAX_PER_USER=20

# How recently a second factor must have been verified for a sensitive operation.
# Bounded to 60..1800 — a window wide enough to be useless is a silent downgrade
# of every sensitive operation.
RB_STEP_UP_WINDOW_SECONDS=600

# -----------------------------------------------------------------------------
# Limits
# -----------------------------------------------------------------------------
RB_MAX_BODY_BYTES=262144                   # 256 KiB
RB_REQUEST_TIMEOUT_SECONDS=30
RB_MAX_PAGE_SIZE=100
RB_DEFAULT_PAGE_SIZE=25

# -----------------------------------------------------------------------------
# CORS — default deny
#
# Comma-separated exact origins, no trailing slash. `*` is NEVER valid for an API
# that accepts bearer credentials and is refused at startup in production, where
# every origin must additionally be https://.
#
# Empty (the default) means no cross-origin browser request is permitted, which is
# correct while no frontend exists.
# -----------------------------------------------------------------------------
RB_CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Trusted proxies — comma-separated CIDRs
#
# X-Forwarded-For is honoured ONLY when the immediate peer is inside one of these
# networks; otherwise the peer address is used and the header is ignored entirely.
# Anyone can send `X-Forwarded-For: 1.2.3.4`, and trusting it blindly lets an
# attacker evade every per-IP rate limit by rotating a header value.
#
# Empty means trust nothing, which is the correct fail-closed default. Development
# falls back to loopback + RFC1918 so docker-compose behaves sensibly.
# -----------------------------------------------------------------------------
RB_TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# Mail
#
# dev_sink  — logs only the mail kind, the recipient's domain, and a message id.
#             Never the body or subject, both of which carry a single-use token.
# dev_file  — writes the full message to a directory. Writes secrets to disk;
#             development only.
# disabled  — refuses to accept mail work, so the flow fails loudly.
#
# There is deliberately NO production provider yet. Production refuses to start
# with a development sink, because a password reset that appears to succeed and
# never arrives locks a user out with no signal. Set `disabled` to acknowledge
# the gap explicitly. See docs/backend/08-operations.md.
# -----------------------------------------------------------------------------
RB_MAIL_PROVIDER=dev_file
RB_MAIL_DIRECTORY=/tmp/roleblank-mail

# -----------------------------------------------------------------------------
# Observability and surface
# -----------------------------------------------------------------------------
# JSON logs are mandatory in production so they are machine-parseable.
RB_LOG_JSON=false

# The API contract is not a public document by default. Production refuses to
# start with this on; serve it behind the operator's own access control instead.
RB_EXPOSE_OPENAPI=true

# The metrics endpoint carries no principal-identifying labels, but it should
# still be restricted by network policy in production.
RB_METRICS_ENABLED=true

# Outbox worker
RB_OUTBOX_POLL_INTERVAL_SECONDS=5
RB_OUTBOX_BATCH_SIZE=20

# Shown in authenticator apps during TOTP enrolment.
RB_TOTP_ISSUER=RoleBlank OS

# Log filter. `sqlx` is pinned to warn by default so that a change here can never
# start emitting SQL with bound parameters at info level.
# RUST_LOG=info,roleblank_backend=debug,sqlx=warn
